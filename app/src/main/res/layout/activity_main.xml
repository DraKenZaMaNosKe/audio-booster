<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/orbix_audio_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="650dp"
            android:background="@drawable/bg_thunder_chassis" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal">
                <com.pixora.volumemax.ThunderSpeakerView android:id="@+id/speakerLeft"
                    android:layout_width="82dp" android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_marginHorizontal="5dp" android:layout_weight="1" android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="112dp"
                        android:background="@drawable/bg_thunder_display" android:padding="8dp">
                        <com.pixora.volumemax.ThunderEqualizerView android:id="@+id/thunderEqualizer"
                            android:layout_width="match_parent" android:layout_height="66dp" android:layout_gravity="bottom"
                            android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:text="THUNDER RUN" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvExternalTrack" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_gravity="bottom" android:ellipsize="end"
                            android:gravity="center" android:maxLines="1" android:text="♫"
                            android:textColor="@color/text_primary" android:textSize="10sp" />
                    </FrameLayout>

                    <TextView android:id="@+id/tvGlobalState" android:layout_width="match_parent"
                        android:layout_height="24dp" android:ellipsize="end" android:gravity="center"
                        android:maxLines="1" android:text="@string/global_state_off"
                        android:textColor="@color/accent_cyan" android:textSize="10sp" />

                    <com.pixora.volumemax.BoostDialView android:id="@+id/boostDial"
                        android:layout_width="220dp" android:layout_height="220dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:gravity="center" android:orientation="horizontal">
                        <Button android:id="@+id/btnExternalPrev" android:layout_width="48dp" android:layout_height="44dp"
                            android:background="@drawable/bg_thunder_button" android:contentDescription="@string/previous_track"
                            android:minWidth="0dp" android:padding="0dp" android:text="◀|" android:textColor="@color/text_primary" />
                        <Button android:id="@+id/btnExternalPlayPause" android:layout_width="58dp" android:layout_height="48dp"
                            android:layout_marginHorizontal="5dp" android:background="@drawable/bg_thunder_button"
                            android:contentDescription="@string/play_pause_external" android:minWidth="0dp"
                            android:padding="0dp" android:text="▶" android:textColor="@color/accent_cyan" android:textSize="18sp" />
                        <Button android:id="@+id/btnExternalNext" android:layout_width="48dp" android:layout_height="44dp"
                            android:background="@drawable/bg_thunder_button" android:contentDescription="@string/next_track"
                            android:minWidth="0dp" android:padding="0dp" android:text="|▶" android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                        android:layout_marginTop="5dp" android:gravity="center" android:orientation="horizontal">
                        <Button android:id="@+id/btnMediaAccess" android:layout_width="46dp" android:layout_height="44dp"
                            android:background="@drawable/bg_thunder_button" android:contentDescription="@string/enable_media_access"
                            android:minWidth="0dp" android:padding="0dp" android:text="♫" android:textColor="@color/accent_cyan"
                            android:textSize="20sp" />
                        <TextView android:id="@+id/tvSafeLimiter" android:layout_width="46dp" android:layout_height="44dp"
                            android:layout_marginHorizontal="8dp" android:background="@drawable/bg_thunder_button"
                            android:contentDescription="@string/safe_limiter_idle" android:gravity="center"
                            android:text="SAFE" android:textColor="#62FFB0" android:textSize="8sp" android:textStyle="bold" />
                        <Button android:id="@+id/btnThunderEq" android:layout_width="46dp" android:layout_height="44dp"
                            android:background="@drawable/bg_thunder_button" android:contentDescription="@string/equalizer_pending"
                            android:minWidth="0dp" android:padding="0dp" android:text="EQ" android:textColor="@color/text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
                        android:layout_marginTop="8dp" android:gravity="bottom" android:orientation="horizontal">
                        <Button android:id="@+id/btnGlobal100" android:layout_width="0dp" android:layout_height="50dp"
                            android:layout_weight="1" android:minWidth="0dp" android:text="100" android:textSize="10sp" />
                        <Button android:id="@+id/btnGlobal150" android:layout_width="0dp" android:layout_height="58dp"
                            android:layout_marginHorizontal="5dp" android:layout_weight="1" android:minWidth="0dp"
                            android:text="150" android:textSize="10sp" />
                        <Button android:id="@+id/btnGlobalMax" android:layout_width="0dp" android:layout_height="50dp"
                            android:layout_weight="1" android:minWidth="0dp" android:text="MAX" android:textSize="9sp" />
                    </LinearLayout>

                    <SeekBar android:id="@+id/seekVolume" android:layout_width="match_parent"
                        android:layout_height="38dp" android:contentDescription="@string/volume_title" />
                    <TextView android:id="@+id/tvVolumeValue" android:layout_width="match_parent"
                        android:layout_height="1dp" android:visibility="invisible" />
                </LinearLayout>

                <com.pixora.volumemax.ThunderSpeakerView android:id="@+id/speakerRight"
                    android:layout_width="82dp" android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:background="@drawable/bg_thunder_tray"
            android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:id="@+id/sectionLocal" android:layout_width="38dp" android:layout_height="match_parent"
                android:contentDescription="@string/player_title" android:gravity="center" android:text="♫"
                android:textColor="@color/accent_cyan" android:textSize="17sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTrack" android:layout_width="match_parent" android:layout_height="22dp"
                    android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1"
                    android:text="—" android:textColor="@color/text_muted" android:textSize="9sp" />
                <TextView android:id="@+id/tvPlayerState" android:layout_width="match_parent" android:layout_height="18dp"
                    android:ellipsize="end" android:maxLines="1" android:text="@string/player_state_placeholder"
                    android:textColor="@color/accent_cyan" android:textSize="8sp" android:visibility="gone" />
            </LinearLayout>
            <Button android:id="@+id/btnSelectAudio" android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_thunder_button" android:contentDescription="@string/select_audio"
                android:minWidth="0dp" android:padding="0dp" android:text="♫+" android:textColor="@color/text_primary"
                android:textSize="10sp" />
            <Button android:id="@+id/btnPlayPause" android:layout_width="42dp" android:layout_height="42dp"
                android:layout_marginStart="5dp" android:background="@drawable/bg_thunder_button"
                android:contentDescription="@string/play" android:minWidth="0dp" android:padding="0dp"
                android:text="▶" android:textColor="@color/accent_cyan" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="5dp" android:gravity="center" android:orientation="horizontal">
            <Button android:id="@+id/btnGainOff" android:layout_width="58dp" android:layout_height="42dp"
                android:contentDescription="@string/gain_off" android:minWidth="0dp" android:text="0" android:textSize="10sp" />
            <Button android:id="@+id/btnGain3" android:layout_width="58dp" android:layout_height="42dp"
                android:layout_marginHorizontal="7dp" android:contentDescription="@string/gain_3"
                android:minWidth="0dp" android:text="+3" android:textSize="10sp" />
            <Button android:id="@+id/btnGain6" android:layout_width="58dp" android:layout_height="42dp"
                android:contentDescription="@string/gain_6" android:minWidth="0dp" android:text="+6" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
            <Button android:id="@+id/btnGlobalOff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal30" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal60" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal125" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal175" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnVolume75" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnVolume100" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/sectionExternal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
