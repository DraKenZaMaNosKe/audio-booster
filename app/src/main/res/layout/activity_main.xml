<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#05070B" android:fitsSystemWindows="true">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:contentDescription="@null" android:importantForAccessibility="no"
        android:scaleType="centerCrop" android:src="@drawable/thunder_room_cabinet_v1" />

<FrameLayout
    android:id="@+id/mainStage" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingBottom="32dp">

        <FrameLayout android:layout_width="360dp" android:layout_height="640dp"
            android:layout_marginTop="20dp" android:scaleX="0.90" android:scaleY="0.90">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="@null" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/thunder_run_stereo_shell_v5" />

            <FrameLayout android:layout_width="196dp" android:layout_height="150dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="50dp"
                android:padding="8dp">
                <com.pixora.volumemax.ThunderEqualizerView android:id="@+id/thunderEqualizer"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:layout_gravity="bottom" android:importantForAccessibility="no" />
                <com.pixora.volumemax.LedBrandView
                    android:layout_width="match_parent" android:layout_height="24dp"
                    android:layout_gravity="top" />
                <TextView android:id="@+id/tvGlobalState" android:layout_width="match_parent"
                    android:layout_height="18dp" android:layout_marginTop="47dp"
                    android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="MEDIA"
                    android:textColor="@color/accent_cyan" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvExternalTrack" android:layout_width="match_parent"
                    android:layout_height="32dp" android:layout_marginTop="16dp" android:ellipsize="end"
                    android:gravity="center" android:maxLines="2" android:text="♫"
                    android:textColor="@color/text_primary" android:textSize="8sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvScreenStats" android:layout_width="match_parent"
                    android:layout_height="18dp" android:layout_gravity="bottom"
                    android:background="#C805070B" android:ellipsize="end" android:gravity="center"
                    android:maxLines="1" android:text="VOL 0%  •  BOOST OFF  •  SAFE"
                    android:textColor="#8BEAFF" android:textSize="6sp" />
            </FrameLayout>

            <ImageView android:id="@+id/knobSprite" android:layout_width="116dp" android:layout_height="116dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="244dp"
                android:contentDescription="@null" android:importantForAccessibility="no"
                android:scaleType="fitCenter" android:src="@drawable/thunder_volume_rotor_v1" />

            <com.pixora.volumemax.BoostDialView android:id="@+id/boostDial"
                android:layout_width="166dp" android:layout_height="166dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="230dp" />

            <ImageButton android:id="@+id/btnExternalPrev" android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="top|start" android:layout_marginStart="82dp" android:layout_marginTop="298dp"
                android:background="@drawable/bg_stereo_side_button" android:backgroundTint="@null"
                android:contentDescription="@string/previous_track" android:padding="9dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_thunder_previous" />
            <ImageButton android:id="@+id/btnExternalNext" android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="top|end" android:layout_marginTop="298dp" android:layout_marginEnd="82dp"
                android:background="@drawable/bg_stereo_side_button" android:backgroundTint="@null"
                android:contentDescription="@string/next_track" android:padding="9dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_thunder_next" />

            <Button android:id="@+id/btnMediaAccess" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="top|start" android:layout_marginStart="84dp" android:layout_marginTop="402dp"
                android:background="@drawable/bg_stereo_round_button" android:backgroundTint="@null"
                android:contentDescription="@string/enable_media_access"
                android:minWidth="0dp" android:padding="0dp" android:text="♫" android:textColor="@color/accent_cyan"
                android:textSize="14sp" />
            <Button android:id="@+id/btnExternalPlayPause" android:layout_width="54dp" android:layout_height="54dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="399dp"
                android:background="@android:color/transparent" android:contentDescription="@string/play_pause_external"
                android:minWidth="0dp" android:padding="0dp" android:text="▶" android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView android:id="@+id/tvSafeLimiter" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="top|end" android:layout_marginTop="402dp" android:layout_marginEnd="84dp"
                android:contentDescription="@string/safe_limiter_idle" android:gravity="center"
                android:includeFontPadding="false" android:maxLines="1" android:text="SAFE"
                android:textColor="#62FFB0" android:textSize="6sp" android:textStyle="bold" />

            <Button android:id="@+id/btnGlobal100" android:layout_width="44dp" android:layout_height="90dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="486dp"
                android:layout_marginEnd="92dp" android:background="@android:color/transparent"
                android:contentDescription="100%" android:minWidth="0dp" android:text="" />
            <Button android:id="@+id/btnGlobal150" android:layout_width="44dp" android:layout_height="90dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="486dp"
                android:background="@android:color/transparent" android:contentDescription="150%"
                android:minWidth="0dp" android:text="" />
            <Button android:id="@+id/btnGlobalMax" android:layout_width="44dp" android:layout_height="90dp"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="486dp"
                android:layout_marginStart="92dp" android:background="@android:color/transparent"
                android:contentDescription="200%" android:minWidth="0dp" android:text="" />

            <Button android:id="@+id/btnThunderEq" android:layout_width="1dp" android:layout_height="1dp"
                android:layout_gravity="bottom|center_horizontal" android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
            android:background="@drawable/bg_thunder_tray" android:gravity="center"
            android:orientation="horizontal" android:paddingHorizontal="16dp"
            android:visibility="gone">
            <TextView android:id="@+id/sectionLocal" android:layout_width="36dp" android:layout_height="match_parent"
                android:contentDescription="@string/player_title" android:gravity="center"
                android:text="♫" android:textColor="@color/accent_cyan" android:textSize="17sp" />
            <TextView android:id="@+id/tvTrack" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp" android:layout_weight="1" android:ellipsize="end"
                android:gravity="center_vertical" android:maxLines="1" android:text="—"
                android:textColor="@color/text_muted" android:textSize="9sp" />
            <Button android:id="@+id/btnSelectAudio" android:layout_width="46dp" android:layout_height="46dp"
                android:background="@drawable/bg_stereo_round_button" android:backgroundTint="@null"
                android:contentDescription="@string/select_audio"
                android:minWidth="0dp" android:padding="0dp" android:text="+" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnPlayPause" android:layout_width="46dp" android:layout_height="46dp"
                android:layout_marginStart="5dp" android:background="@drawable/bg_stereo_round_button"
                android:backgroundTint="@null"
                android:contentDescription="@string/play" android:minWidth="0dp" android:padding="0dp"
                android:text="▶" android:textColor="@color/accent_cyan" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
            android:gravity="center" android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/btnGainOff" android:layout_width="58dp" android:layout_height="42dp"
                android:background="@drawable/bg_stereo_capsule_button" android:backgroundTint="@null"
                android:contentDescription="@string/gain_off" android:minWidth="0dp" android:text="0"
                android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnGain3" android:layout_width="58dp" android:layout_height="42dp"
                android:layout_marginHorizontal="8dp" android:background="@drawable/bg_stereo_capsule_button"
                android:backgroundTint="@null" android:contentDescription="@string/gain_3"
                android:minWidth="0dp" android:text="+3" android:textColor="@color/accent_cyan" />
            <Button android:id="@+id/btnGain6" android:layout_width="58dp" android:layout_height="42dp"
                android:background="@drawable/bg_stereo_capsule_button" android:backgroundTint="@null"
                android:contentDescription="@string/gain_6" android:minWidth="0dp" android:text="+6"
                android:textColor="#FF7048" />
        </LinearLayout>

        <FrameLayout android:id="@+id/adBannerSlot" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp" android:background="@drawable/bg_thunder_tray"
            android:contentDescription="@string/ad_space_description" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="AD" android:textColor="#667B8A9C"
                android:textSize="8sp" android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
            <SeekBar android:id="@+id/seekVolume" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvVolumeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvPlayerState" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/sectionExternal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobalOff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal30" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal60" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal125" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnGlobal175" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnVolume75" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnVolume100" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
</FrameLayout>
