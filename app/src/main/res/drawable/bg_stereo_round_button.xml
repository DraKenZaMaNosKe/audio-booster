<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="#12151B" android:centerColor="#58606B" android:endColor="#111319" />
            <stroke android:width="2dp" android:color="#25DDF5" />
            <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="#818895" android:centerColor="#30343D" android:endColor="#0B0D12" />
            <stroke android:width="1dp" android:color="#AAB0BC" />
            <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
