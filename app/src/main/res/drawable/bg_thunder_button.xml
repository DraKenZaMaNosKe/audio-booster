<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#171922" android:endColor="#555B68" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#FF7048" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#666D7B" android:centerColor="#292C35" android:endColor="#101119" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#88909F" />
        </shape>
    </item>
</selector>
