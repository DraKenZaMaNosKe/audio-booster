<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#203E4B" android:centerColor="#0C1820" android:endColor="#020508" />
            <stroke android:width="2dp" android:color="#FF6544" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#5C6876" android:centerColor="#1B222B" android:endColor="#05080D" />
            <stroke android:width="1dp" android:color="#37E6FF" />
        </shape>
    </item>
</selector>
