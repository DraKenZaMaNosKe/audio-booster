<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#11141A" android:endColor="#4E5662" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="#25DDF5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#6C7380" android:centerColor="#292D35" android:endColor="#090B10" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#818A98" />
        </shape>
    </item>
</selector>
