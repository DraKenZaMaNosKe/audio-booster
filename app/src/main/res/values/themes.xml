<resources>
    <style name="Theme.PixoraVolumeMax" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.AudioBooster.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AudioBooster.Dialog</item>
    </style>

    <style name="Theme.AudioBooster.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_audio_booster_brand</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="postSplashScreenTheme">@style/Theme.PixoraVolumeMax</item>
    </style>

    <style name="Widget.AudioBooster.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/primary_purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.AudioBooster.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AudioBooster.Dialog</item>
    </style>

    <style name="ShapeAppearance.AudioBooster.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">28dp</item>
    </style>
</resources>
